# Firebase Configuration
REACT_APP_FIREBASE_API_KEY=your_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# Hugging Face (SIM-BOT assistant)
# The key is kept SERVER-SIDE in the Cloud Function, never bundled into the frontend.
# Get a READ token at https://huggingface.co/settings/tokens, then configure it with:
#   firebase functions:config:set huggingface.key "hf_XXXXXXXXXXXX"
# (This .env var is only used as a local fallback when emulating functions.)
HF_API_KEY=hf_your_api_key_here

# Web3Forms access keys (public — safe to expose in client-side code)
# Create a form at https://web3forms.com and paste each form's access key below.
REACT_APP_WEB3FORMS_VOLUNTEER_KEY=your_volunteer_form_key
REACT_APP_WEB3FORMS_DONATION_KEY=your_donation_form_key
REACT_APP_WEB3FORMS_CONTACT_KEY=your_contact_form_key
REACT_APP_WEB3FORMS_PHOTO_KEY=your_photo_form_key
